# Copy this file to .env and fill in real values. Never commit .env.

# Folder the agent can see. Relative paths are resolved from the project folder.
# For grading use sample_workspace. For private use point to a folder outside the repo.
WORKSPACE_ROOT=sample_workspace

# Where the HTTP server listens (local only; ngrok exposes it in M3)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Limits
MAX_FILE_BYTES=102400

# Authentication. Generate a long random string (32+ chars), never reuse a real password.
MCP_TOKEN=replace-with-a-long-random-string
NGROK_AUTHTOKEN=replace-with-your-ngrok-authtoken

# Public address (M3). Your ngrok static domain, hostname only, no https://
NGROK_DOMAIN=your-name.ngrok-free.app
# Optional: full path to ngrok.exe if 'ngrok' is not on your PATH (used by pm2)
# NGROK_PATH=C:\path\to\ngrok.exe
